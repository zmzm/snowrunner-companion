{
  "name": "snowrunner-companion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @snowrunner/web dev",
    "import:srnfo": "tsx tools/data-import/src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.tooling.json && pnpm -r typecheck",
    "test": "vitest run && node --test tools/*.test.mjs",
    "test:watch": "vitest",
    "build": "pnpm typecheck && pnpm --filter @snowrunner/web build",
    "preview": "pnpm --filter @snowrunner/web preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm check:data-boundary && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:data-boundary": "node tools/check-data-boundary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
